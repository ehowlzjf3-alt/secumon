us","version":"1","description":"Read this work resource ledger and delegated task usage. Resources belong to work, not the lifetime of a resident agent.","effect":"read","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"offset":{"default":0,"type":"integer","minimum":0,"maximum":9007199254740991},"limit":{"default":10,"type":"integer","minimum":1,"maximum":20}},"additionalProperties":false},"outputSchema":{"type":"object"},"destination":"local","labels":[]},{"provider":"core","id":"core.budget.allocate","version":"1","description":"Reserve part of this work allowance for a temporary task. Without recipientId use this owner and scope; recipientId selects an explicitly registered host recipient and its fixed policy/scope. Host approval is required. Does not run it or create a resident-agent relationship.","effect":"read","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"goal":{"type":"object","properties":{"revision":{"type":"integer","minimum":1,"maximum":9007199254740991},"description":{"type":"string","minLength":1,"maxLength":100000},"scope":{"type":"string","minLength":1,"maxLength":256},"mode":{"type":"string","enum":["auto","fast","deep"]},"criteria":{"maxItems":100,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":256},"description":{"type":"string","maxLength":100000},"key":{"type":"string","minLength":1,"maxLength":256},"operator":{"type":"string","enum":["equals","present"]},"equals":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},"minIndependentSources":{"type":"integer","minimum":1,"maximum":9007199254740991},"requireCompleteCoverage":{"type":"boolean"},"requireCollection":{"type":"object","properties":{"queryDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"snapshot":{"type":"string","minLength":1,"maxLength":256}},"required":["queryDigest"],"additionalProperties":false}},"required":["id","description","key","operator","equals","minIndependentSources","requireCompleteCoverage"],"additionalProperties":false}},"responseRequirement":{"type":"object","properties":{"version":{"type":"number","const":1},"requestMessageId":{"type":"string","minLength":1,"maxLength":256},"requestTextDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"format":{"type":"string","const":"text"}},"required":["version","requestMessageId","requestTextDigest","format"],"additionalProperties":false}},"required":["revision","description","scope","mode","criteria"],"additionalProperties":false},"limits":{"type":"object","properties":{"toolCalls":{"type":"integer","minimum":0,"maximum":9007199254740991},"modelCalls":{"type":"integer","minimum":0,"maximum":9007199254740991},"tokens":{"type":"integer","minimum":0,"maximum":9007199254740991},"replans":{"type":"integer","minimum":0,"maximum":9007199254740991},"wallTimeMs":{"type":"integer","minimum":1,"maximum":9007199254740991}},"required":["toolCalls","modelCalls","tokens","replans","wallTimeMs"],"additionalProperties":false},"recipientId":{"type":"string","minLength":1,"maxLength":256}},"required":["goal","limits"],"additionalProperties":false},"outputSchema":{"type":"object"},"destination":"local","labels":[]},{"provider":"core","id":"core.budget.run","version":"1","description":"Run an explicitly allocated temporary task through the same runtime. Peer consultation uses its own independent allowance instead.","effect":"read","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"grantId":{"type":"string","minLength":1,"maxLength":256},"maxSteps":{"type":"integer","minimum":1,"maximum":100}},"required":["grantId","maxSteps"],"additionalProperties":false},"outputSchema":{"type":"object"},"destination":"local","labels":[]},{"provider":"core","id":"core.budget.increase","version":"1","description":"Add resources to an existing grant within this work original allowance. Does not increase the sponsor hard limit.","effect":"read","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"grantId":{"type":"string","minLength":1,"maxLength":256},"extra":{"type":"object","properties":{"toolCalls":{"type":"integer","minimum":0,"maximum":9007199254740991},"modelCalls":{"type":"integer","minimum":0,"maximum":9007199254740991},"tokens":{"type":"integer","minimum":0,"maximum":9007199254740991},"replans":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["toolCalls","modelCalls","tokens","replans"],"additionalProperties":false}},"required":["grantId","extra"],"additionalProperties":false},"outputSchema":{"type":"object"},"destination":"local","labels":[]},{"provider":"core","id":"core.budget.request","version":"1","description":"Record a request for additional resources for the sponsor or operator to consider. A request is not permission to spend more.","effect":"read","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"extra":{"type":"object","properties":{"toolCalls":{"type":"integer","minimum":0,"maximum":9007199254740991},"modelCalls":{"type":"integer","minimum":0,"maximum":9007199254740991},"tokens":{"type":"integer","minimum":0,"maximum":9007199254740991},"replans":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["toolCalls","modelCalls","tokens","replans"],"additionalProperties":false},"reason":{"type":"string","minLength":1,"maxLength":2000}},"required":["extra","reason"],"additionalProperties":false},"outputSchema":{"type":"object"},"destination":"local","labels":[]},{"provider":"core","id":"core.budget.return","version":"1","description":"Stop using this task own delegated allowance and request its return. Measured usage and unresolved effects stay accountable; the resident agent session remains open.","effect":"read","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{},"additionalProperties":false},"outputSchema":{"type":"object"},"destination":"local","labels":[]},{"provider":"core","id":"core.budget.revoke","version":"1","description":"Stop further use of a grant and start draining running calls. Unused resources return only after measured usage and effects are reconciled.","effect":"read","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"grantId":{"type":"string","minLength":1,"maxLength":256}},"required":["grantId"],"additionalProperties":false},"outputSchema":{"type":"object"},"destination":"local","labels":[]},{"provider":"core","id":"core.budget.reconcile","version":"1","description":"Refresh actual delegated usage and return unused resources when the task is drained. Unknown usage remains held.","effect":"read","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"grantId":{"type":"string","minLength":1,"maxLength":256}},"required":["grantId"],"additionalProperties":false},"outputSchema":{"type":"object"},"destination":"local","labels":[]}]}}