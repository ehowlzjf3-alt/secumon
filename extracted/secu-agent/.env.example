# ============================================================
# secu-agent 환경 변수 (template)
# 사용: cp .env.example .env  →  값 채움
# ============================================================

# --- 작업/결과 디렉토리 ---
SA_RESULTS_DIR="${HOME}/secu-agent/findings"

# --- 사내 LLM 게이트웨이 ---
# ai-sandbox/ai-soc과 동일 게이트웨이 사용. ticket은 ai-soc 운영팀에서 발급.
OPENAI_CRED_KEY=""
SOC_USER_ID="$(whoami)"

# F1: Gauss 4.1 (text) — 'gauss' 프로필 활성용. gpt-oss 와 별개 ticket.
# 판단정확도(F2) 라벨링용 두 번째 라이브 모델. base_url/model 은 사내 gauss 4.1 엔드포인트.
GAUSS41_API_BASE=""
GAUSS41_MODEL=""
GAUSS41_CRED_KEY=""

# v3.90: 사내 security 게이트웨이(LiteLLM) — 'gauss-o32'/'gauss-o41' 프로필용 Bearer 키.
# base_url/model 은 llm_profiles.yaml 에 하드코딩(비밀 아님), 키만 여기서 주입.
LITELLM_API_KEY=""

# --- v3.81 T1: 자율 루프/모델 라우팅 ---
# 연속 무진전 judge 턴(flips=0 ∧ added=0) 허용치 — 초과 시 GoalPaused.
# 0 = 비활성 (max_turns=0 goal 무한루프 재개방 — 운영자 명시 선택만).
# SA_GOAL_NO_PROGRESS_LIMIT="3"
# goal 체크리스트 최대 항목 수 — judge new_items 무한 증식 안전 상한(audit #5).
# 기본 100. 하위태스크가 많은 큰 목표를 위해 운영자가 상향 가능(0/무효 = 기본).
# SA_GOAL_CHECKLIST_MAX="100"
# --- v3.87 F2 확장: goal judge 비용/품질 ---
# F2-B evidence-delta pre-gate: 확정 증거가 안 변한 구간에서 judge 를 미룰 최대 턴 수.
# 마지막 clean judge 이후 이 턴수가 지나면 강제 judge(judge_every 와 무관, boundary 는
# 항상 우선). 0 = 비활성(매 eligible 턴 judge). 기본 5.
# SA_GOAL_EVIDENCE_SKIP_MAX="5"
# F2-E done-critic: 인용 증거(finding·evidence) 없는 '완료'를 needs_review 로 검토 pause.
# fire-once(재-pause 루프 없음). 0/false 로 끄면 기존 auto-done 복원. 기본 on.
# SA_GOAL_DONE_CRITIC="1"
# adaptive judge routing: goal judge 출력 예산 상한. 큰 checklist/증거일수록 예산을 이
# 값까지 상향해 출력 truncation(파싱실패)을 막는다(작은 판정은 base 8192 그대로). effort 는
# 파싱 안전 위해 low 고정. 기본 16384(대부분 게이트웨이 지원), 최소 8192. codex judge 는
# max_tokens 미사용이라 무효(자체 예산 관리). 8192-한도 backend 는 8192 로 낮춰 스케일 끔.
# SA_GOAL_JUDGE_MAX_TOKENS="16384"
# goal-scoped evidence(#17): judge 접지 digest 를 goal 수명(last_seen>=created_at) 동안
# 관측된 finding 으로 좁힌다 — 무관한 이전 goal 의 finding 혼입 방지. 0/false 로 끄면 전역
# digest(구동작). 기본 on.
# SA_GOAL_SCOPED_EVIDENCE="1"
# sub-agent 재귀 깊이 한도 (SA_AGENT_DEPTH 는 워커 env 로 자동 +1 상속).
# SA_AGENT_MAX_DEPTH="2"
# ============================================================================
# 역할별 LLM 프로파일 — 축이 셋이다. SA_CHAT_PROFILE 하나로는 표현이 안 된다.
# (프로파일 이름 = config/llm_profiles.yaml 의 키. 로스터 기록은 그 .example 파일.)
#
#   ① 검토원/워커  SA_CHAT_PROFILE  + SA_CHAT_PROFILE_CHAIN
#   ② 리드(판단)   SA_LEAD_PROFILE  + SA_LEAD_PROFILE_CHAIN
#   ③ vision 대체  env 없음 — 코드 기본(skill vision_compat._DEFAULT_UNSUPPORTED).
#                  이미지가 근거인 워커(smb·dev_web)는 전역 프로파일이 이미지를 못 받으면
#                  도메인 기본(gemma)으로 자동 대체된다. 목록을 바꿔야 하면 skill 쪽
#                  SA_VISION_UNSUPPORTED_PROFILES 인데 그건 **추가가 아니라 완전 대체**다.
#
# ★ 이 파일이 워커 LLM 의 단일소스다. skill .env 에서 SA_CHAT_PROFILE 을 핀하면
#   load_runtime_env first-wins 로 이겨서 split-brain(챗만 바뀌고 워커는 구 모델)이 된다.
#   스킬쪽 핀 금지.
#
# --- 프리셋: 쓸 블록 하나만 주석 해제한다 ---------------------------------------
#
#  [A] 사설 deepseek 워커 + 사외 codex 리드      ← 2026-08-22 현재 구성
#      SA_CHAT_PROFILE="deepseek"
#      SA_CHAT_PROFILE_CHAIN="deepseek,gemma"
#      SA_LEAD_PROFILE="codex"
#
#  [B] 전부 사내 gemma — 사외 egress 0. codex OAuth 가 죽었거나 끄고 싶을 때
#      SA_CHAT_PROFILE="gemma"
#      SA_CHAT_PROFILE_CHAIN="gemma"
#      SA_LEAD_PROFILE="gemma"
#
#  [C] 리드까지 사설 deepseek — 사외 egress 0. **리드 모델 A/B 측정용**
#      SA_CHAT_PROFILE="deepseek"
#      SA_CHAT_PROFILE_CHAIN="deepseek,gemma"
#      SA_LEAD_PROFILE="deepseek"
#      ★ `SA_LEAD_PROFILE_CHAIN` 은 **비워 둔다**(설정하지 않는다). 리드에 폴백을 달면
#        판단이 어느 모델에서 나왔는지 사라져 A/B 자체가 무의미해진다 — 이 프리셋의
#        존재 이유가 바로 그 측정이다. 검토원 체인(위 두 줄)은 그대로 둬도 된다:
#        A/B 대상이 아니고, 워커가 간헐 500 으로 죽는 걸 막는 쪽이 더 중요하다.
#      ※ 리드는 이미지를 안 받으므로(require_vision=False) deepseek 의 vision 400 은
#        리드 경로에선 무관하다. tool calling 은 정식 지원(deepseek_v4 파서).
#
#  [D] 리드만 끈다(역할 분리 없이 전역 하나로) — SA_LEAD_PROFILE 을 빈 값으로 두면
#      리드도 전역 프로파일·전역 체인을 쓴다. Phase 3 이전 동작.
#      SA_LEAD_PROFILE=""
#
# ⚠️ SA_LEAD_PROFILE 을 설정하면 리드는 **전역 체인을 물려받지 않는다.** 폴백을 원하면
#    SA_LEAD_PROFILE_CHAIN 을 따로 쓴다(미설정 = 폴백 없음). 이건 의도다 — 리드가 codex
#    로 시작해 gemma 로 조용히 넘어가면 "누가 판단했나" 가 로그로 구분되지 않는다.
# ⚠️ 없는 프로필 이름은 `_profile_names_from_env` 가 **조용히 버린다.** 안 깨지고 사내
#    기본으로 fail-safe 하므로 오타를 알려주지 않는다 → `cli doctor` 로 확인할 것.
#    (2026-08-20 에 gauss-o32·gpt-oss·gauss-o41 을 은퇴시켰다. 구 env 가 여기 걸린다.)
# ⚠️ chat 경로 체인은 **에러(transient/rate_limit/auth)일 때만** 다음으로 넘어간다.
#    빈-content 는 성공한 스트림이라 체인으로 구제되지 않는다 — 기본값이 유일한 레버다.
#
# 워커(cli) 프로파일 우선순위: argv --profile-name > SA_CHAT_PROFILE > YAML 첫 항목.
# sub-agent 별 고정은 agents/<name>.md frontmatter `profile:` 로.
#
# 판정/요약만 다른 모델로 돌리고 싶을 때(미설정 = 세션 client 그대로):
# SA_JUDGE_PROFILE="o4-mini"
# SA_SUMMARIZER_PROFILE="o4-mini"
# ============================================================================
# 무인(schedule_origin) 실행 capability allowlist — 기본 fail-closed:
# 스케줄러/자율 루프에서 python_exec(임의 코드) 및 destructive 도구는 승인 없이
# 차단된다. 신뢰 자동화에 한해 도구명을 comma 로 명시 opt-in 하면 그 도구만
# 무인 실행 허용 (미설정 = 전면 차단). 대화형(사람 있음) 실행에는 영향 없음.
# SA_AUTONOMOUS_TOOLS="python_exec"
# smart 승인 모드에서 결정론 auto-allow(=LLM judge 스킵) 할 read-only 실행파일을
# 추가한다. 기본 집합은 cat/grep/rg/head/tail/find(가드)/sort(가드) 등 인자까지
# read-only 인 것만 — awk/sed 나 셸 체이닝/리다이렉트는 judge 로 간다. 자동화가
# 신뢰하는 도메인 read-only 도구를 judge 없이 쓰려면 여기 추가(체이닝 가드는 유지).
# SA_SMART_READONLY_EXES="mydomain_readonly_tool"

# --- finding 담당자 메일 발송: Knox Mail MCP 사용 ---
# 미설정 시 메일 발송 자체가 거부된다 (fail-closed — 코드에 기본 호스트 없음).
SA_KNOX_MAIL_MCP_URL="http://<knox-mail-mcp-host>:8005"
SA_KNOX_MAIL_SENDER="dssoc"

# --- v3.81 T2: delivery sink egress 정책 (기본 = 전부 dry-run) ---
# 자율발송 4조건 전부 충족해야 실발송: ① sink opt-in ② (설정 시) charter
# 일치 ③ 수신자 allowlist 매칭(미설정 = 자율발송 전면 불가) ④ 마스킹 후
# secret/PII 스캔 잔존 0. 하나라도 미충족 → draft 생성 + audit 만.
# SA_DELIVERY_AUTOSEND_SINKS="knox_mail"
# SA_DELIVERY_AUTOSEND_CHARTERS="CHG-2026-042"
# SA_DELIVERY_RECIPIENT_ALLOW="samsungds.net, partner.example.com"

# --- 웹 안전/scope (코어 url_safety + browser_tool 소유) ---
WEB_USER_AGENT="secu-agent/0.1 (internal-security-scan; contact=secops@example.com)"
WEB_REQUEST_TIMEOUT="10"
# web_fetch 기본 transport 는 httpx. TLS impersonation 이 필요한 인가된 점검에서만
# `uv sync --extra web-adaptive` 후 tool input 으로 transport="curl_cffi" 를 명시.
# 이 경우에도 url_safety scope/hard-block 과 redirect 미추적 정책은 동일하게 적용.
# 비워두면 기존 hard-block(file/loopback/link-local/metadata)만 적용.
# 값을 넣으면 agent는 지정된 도메인/대역 안에서만 web fetch/browser_action 가능.
# 도메인은 exact + subdomain 매칭: "corp.example.com" → "app.corp.example.com" 포함.
SA_WEB_ALLOWED_DOMAINS="corp.example.com, apps.example.com"
SA_WEB_ALLOWED_CIDRS="10.50.0.0/16, 172.20.0.0/16"
# true면 allowed domains/cidrs 미설정 상태의 웹 접근을 전부 차단.
SA_WEB_REQUIRE_SCOPE="true"
# DNS 재바인딩 방어(audit #7): web_fetch/browser 연결 직전 호스트명을 resolve 해
# 결과 IP 가 하드블록(loopback/metadata/CGNAT 등)에 걸리면 거부. 기본 ON.
# 0/false/no/off 로 두면 resolve 검사만 끈다(문자열 하드블록·scope 는 유지) —
# 운영 kill-switch. 정상 해석은 통과하므로 자동화에 영향 없음.
# SA_WEB_DNS_REBIND_CHECK="1"

# --- v3.81 T3: 외부 skills 디렉토리 (재부착 plugin 로드 경로) ---
# 다중 경로 (':' 또는 ',' 구분). 코어 내장 skills 뒤에 붙는다 — 이름 충돌
# 시 코어 우선 (외부가 코어 보안 skill 을 override 못 함).
# SA_SKILLS_DIRS="${HOME}/project/secu-agent-skill/skills"

# --- v3.82 U2: plugin 부트스트랩 (재부착 운반체) ---
# 프로세스 시작 시 1회 import 되는 모듈 목록 (':' 또는 ',' 구분).
# importable 모듈명 또는 .py 파일 경로. plugin 은 import 부수효과로
# register_agent_type/register_finding_category/register_delivery_sink 등
# 코어 등록 API 를 호출한다. import 실패 = 시작 중단 (fail-loud).
# 주의: 임의 코드 실행 — 신뢰하는 plugin repo 경로만 지정할 것.
# SA_PLUGINS="${HOME}/project/secu-agent-skill/plugin/bootstrap.py"

# --- v3.79-perf: 성능/리소스 튜닝 노브 (전부 안전 기본값 — 미설정 시 기존 동작) ---
# 새 하드 리밋은 전부 env 로 열어 자동화/운영자가 조정 가능. 기본값은 현행 동작 보존.
#
# python_exec: 캡처 stdout 절단 상한(chars). host 도구들과 동일 기본 30_000.
# 실행은 이벤트루프를 막지 않도록 전용 daemon thread 로 offload + timeout 경계.
# SA_PYTHON_EXEC_MAX_OUTPUT="30000"
# context_brief: 매 turn 스캔하는 최근 chat_message 최대 행수(O(history)→O(N)).
# SA_CONTEXT_BRIEF_MAX_MESSAGES="200"
# evidence 디스크 size-cap 스캔 throttle 간격(초). 매 tool 완료마다 전체 rglob+stat
# 하던 O(files) walk 를 억제 — 최근값 캐시, 최대 이 간격마다만 재-walk. 0=매번 스캔.
# SA_EVIDENCE_SIZE_SCAN_INTERVAL_SEC="10"
# context summarizer: summary 트리거 임계치 override(tokens). 미설정=호출부 기본값.
# summary 생성 실패 시 중간 turn 을 비가역 드롭하지 않고 recoverable fallback 사용.
# SA_SUMMARY_TRIGGER_TOKENS=""
# summary 실패 fallback 의 char 예산 — 이 안이면 원본 유지(파괴 0), 초과분만 축소.
# SA_SUMMARY_WINDOW_CHARS="454000"
# web_fetch(curl_cffi adaptive): 캐시할 (host,impersonate) Session 최대 수(LRU).
# 초과 시 가장 오래된 세션을 close+evict — fd/메모리 누수 방지. httpx 기본경로 무관.
# SA_WEB_SESSION_POOL_MAX="32"
# --- v3.87 F4-C: 비전 브라우징(이미지 되먹임) ---
# browser_query(action='screenshot', return_image=true) 로 스크린샷 픽셀을 모델에 되먹인다.
# 턴당 되먹일 이미지 총 base64 바이트 상한(컨텍스트/비용 보호). 0=이미지 되먹임 끔. 기본 4MB.
# SA_TOOL_IMAGE_MAX_BYTES="4194304"
# 히스토리에 유지할 최근 이미지 수 — 나머지는 텍스트 placeholder 로 치환(반복 스크린샷
# 컨텍스트 무한 누적 방지). 0=매턴 즉시 치환(현재 턴만 이미지). 기본 2.
# SA_TOOL_IMAGE_HISTORY_KEEP="2"
# screenshot 인라인 상한(원본 PNG 바이트). 초과 시 파일만 저장하고 인라인 생략. 기본 2MB.
# SA_BROWSER_SCREENSHOT_INLINE_MAX_BYTES="2097152"
# process 도구: in-memory 프로세스 레지스트리 상한. 종료된 레코드 우선 evict,
# 전부 실행중이면 새 spawn 을 거부(live 프로세스는 절대 drop 안 함). 최소 1.
# SA_PROCESS_REGISTRY_MAX="64"
# sandbox: timeout SIGKILL 후 자식 reap(pipe drain+close+wait) bounded 대기(초).
# D-state 프로세스에서 무한 대기 금지 — 작게 유지. 잘못된/비양수는 기본값.
# SA_SANDBOX_REAP_TIMEOUT_SEC="2.0"
# WorkerPool._terminate: SIGKILL 후 최종 proc.wait() 상한(초). un-killable(D-state/
# 멈춘 NFS) 워커가 롤링 풀을 wedge 하지 못하게 — 초과 시 대기를 포기하고 진행.
# SA_WORKER_KILL_WAIT_SEC="10"
# postgres 커넥션 풀(state.py): max/min 크기 + checkout 대기 관측.
# 부하 시 checkout 블로킹이 안 보이던 문제 — 대기가 임계를 넘으면 풀 통계와 함께 경고.
# SA_PG_POOL_MAX_SIZE="10"
# SA_PG_POOL_MIN_SIZE="1"
# SA_PG_POOL_WAIT_WARN_SEC="1.0"

# 도메인(점검) 변수 — GITHUB_*/JENKINS_*/CONFLUENCE_*/SMB_*/SA_LOOP 등은
# secu-agent-skill/.env.example 로 분리됨 (재부착 시 합침)
