# ============================================================
# digisecu-employee — 환경 변수 템플릿
# 실제 자격증명/토큰 값은 절대 커밋 금지. .env.example 만 커밋한다.
# 임직원별 개인 시크릿(POP3/Knox)은 파드에 스코프 주입되며, 실제 값은 시크릿 스토어에.
# ============================================================

# --- 컨트롤 플레인 (control-plane, TS Express) ---
PORT="8080"
# 컨트롤플레인 전용 별도 DB (도메인 DB와 분리 — ADR 0005). 실 값은 로컬 .env 에만.
CONTROL_PG_DSN="postgresql://digisecu:CHANGEME@localhost:5432/digisecu_control"
# dev/demo 수동 사용액 기록 엔드포인트(POST /api/employees/:id/usage) 활성화. 기본 OFF.
# 켜면 예산 하드스톱을 원장으로 시연 가능하지만 임의 차단 DoS 경로가 열리므로 데모 시에만 "true".
DEV_USAGE_ENABLED="false"
# P4 권한분리: 승인/반려 + 운영 조작(approve/reject/pause/resume/disable-send/usage/telemetry) 실행은 이 Bearer
# 토큰(=사람 승인자)만. 제안/요청 엔드포인트는 열려 있음(에이전트가 propose) — 실행만 사람. 자율 에이전트는
# control-plane 직접 호출이라 토큰이 없어 실행 불가(propose→self-approve·kill-switch 무력화 차단).
APPROVER_TOKEN=""
# 기본 fail-closed: APPROVER_TOKEN 미설정이면 승인/운영 조작이 전부 403. 무인증 dev를 원할 때만 명시적으로 true.
# 운영 배포에선 절대 켜지 말 것(대신 APPROVER_TOKEN 설정). NODE_ENV 판정에 의존하지 않는다(오타 fail-open 회피).
ALLOW_INSECURE_DEV_APPROVER="false"

# --- web (React/Vite) ---
# dev 서버는 /api·/health 를 control-plane(8080)으로 프록시(vite.config.ts).
# 승인자 토큰은 vite 프록시가 서버측에서 /api에 주입(브라우저 미노출) → 사람(UI)은 승인, 에이전트는 403.
# APPROVER_TOKEN을 web 프로세스 env에도 동일하게 주입해야 UI 승인이 동작(미설정 시 무인증 dev).

# ============================================================
# 아래는 M3+ (파드 런타임). M0 골격에서는 미사용 — 값 채우지 말 것.
# ============================================================

# --- 엔진/스킬 attach (파드 이미지, 무수정 확장) — secu-agent v3.85+ 정합(HUNT_/TH_→SA_) ---
# ⚠️ 이 블록은 **파드에 주입할 항목 목록**이지 값의 소유처가 아니다. 로컬 실행값은
#    engine/.env · skill/.env 가 소유한다 — 소유권 규칙: secu-agent-skill/docs/CONFIG-OWNERSHIP.md
SA_ENGINE_DIR="${HOME}/project/secu-agent"
# SA_PLUGINS: 미설정/import 실패 시 엔진이 rc2로 죽거나 도메인능력 0(generic degrade). 파드 필수.
SA_PLUGINS="${HOME}/project/secu-agent-skill/plugin/bootstrap.py"
# 도메인별: domains/<domain>/skills (예: domains/smb/skills). SA_PLUGINS와 함께 파드에 반드시 주입.
SA_SKILLS_DIRS=""
# ⚠️ SA_CHAT_PROFILE 은 여기서 **의도적으로 뺐다**(2026-08-15). 워커 LLM 단일소스는 engine/.env 다.
#    여기(또는 skill/.env)에 값을 넣으면 v3.90 split-brain — 챗만 바뀌고 워커는 구 모델로 남는다.
#    파드에서 모델을 바꿔야 하면 engine/.env(이미지) 를 고치거나 파드 env 로 1곳에서만 override.
#    같은 이유로 SA_LEAD_PROFILE(리드 판단자 모델)도 여기 없다 — engine/.env 소유.
#    프리셋([A] deepseek+codex / [B] 전부 gemma / [C] 전부 deepseek / [D] 역할분리 끄기)은
#    secu-agent/.env.example 의 "역할별 LLM 프로파일" 블록. 배경은 docs/LLM-BACKEND.md.
# 엔진 state DB(라이브 DB명은 threat_hunter — 물리명 유지, 리네임은 패키지/env 접두사 수준). control-plane digisecu_control과 분리.
# NOTE: 게이트웨이는 같은 DB를 **다른 role**(digisecu_gw_ro)로 읽는다 — 값이 engine/.env 와
#       달라야 정상이다(중복이 아니라 권한 분리). 아래 M4 절 참고.
SECU_AGENT_PG_DSN="postgresql://secu:CHANGEME@localhost:5432/threat_hunter"
SA_RESULTS_DIR="/results"
# boot/§6 안전 env: 스케줄러 off(자율루프 없음)·web scope 강제. AUTOSEND/AUTONOMOUS 미설정=dry-run/무인차단(fail-closed).
SA_SCHEDULER="off"
SA_WEB_REQUIRE_SCOPE="true"

# --- M4 read 게이트웨이 (gateway/, threat_hunter read-only의 유일 외부 reader) ---
# 게이트웨이는 위 SECU_AGENT_PG_DSN을 재사용하되 전용 read-only role(digisecu_gw_ro,
# gateway/sql/001_readonly_role.sql)로 접속 권장. control-plane과 별개 프로세스(:8091).
GATEWAY_TOKEN=""          # /gw Bearer 토큰. 미설정=fail-closed(모든 요청 401)
GATEWAY_HOST="127.0.0.1"  # 공개 노출 금지(read-only는 기밀성 경계 아님)
GATEWAY_PORT="8091"
# web(vite) dev 프록시가 /gw로 전달할 대상 + 서버측 주입 토큰(브라우저 미노출).
GATEWAY_URL="http://127.0.0.1:8091"

# --- 파드별 MCP 구성 (임직원별) ---
# NOTE: secu-agent .env.example 에 미문서화였던 항목 — digisecu 에서 명시.
MCP_INTERNAL_HOST=""
MCP_EXTERNAL_HOST=""

# --- 임직원별 POP3 (인바운드 수집, 수동+dedup+DELE 금지) ---
# (사용자 확인 필요) 실 호스트는 시크릿 스토어/환경 주입. 미설정=차단. 예: pop3.<internal>
POP3_HOST=""
POP3_PORT="995"
POP3_USER=""
POP3_PASSWORD=""

# --- 임직원별 Knox Mail (아웃바운드, autosend opt-in / fail-closed) ---
SA_KNOX_MAIL_MCP_URL=""
MAIL_SENDER_EMAIL=""
# autosend opt-in sink. 수신 허용목록이 비면 fail-closed(발송 차단).
SA_DELIVERY_AUTOSEND_SINKS="knox_mail"
SA_DELIVERY_RECIPIENT_ALLOW=""
# dev-safe 기본: 조치요청/재검증 회신은 DSSOC로만. per-owner 발송은 M5 명시적 opt-in.
SMB_REMEDIATION_MAIL_MODE="dssoc_only"
SMB_REMEDIATION_DSSOC_RECIPIENT="dssoc@example.com"

# --- 거버넌스 ---
# 위험 행동(실발송 활성화 / terminate / 파드 삭제 / 예산 초과)은
# fail-closed + 명시적 승인 게이트 + 감사로그 뒤에서만. 실 값 채우기 전 사용자 확인.
