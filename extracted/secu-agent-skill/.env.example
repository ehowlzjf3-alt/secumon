# ============================================================
# secu-agent-skill (도메인 plugin) 환경 변수 — 엔진 .env.example 에서 분리
# 재부착 시 엔진 .env 에 합쳐 사용
# ============================================================

# --- 사내 GitHub Enterprise ---
GITHUB_BASE_URL="https://github.intra.example.com/api/v3"
GITHUB_TOKEN=""

# --- GitHub E2E 파이프라인 독립 서비스 ---
SA_GITHUB_WEB_PORT="8770"
SA_GITHUB_WEB_HOST="0.0.0.0"
GITHUB_PIPELINE_POLL_SECONDS="60"
GITHUB_DISCOVERY_MAX_REPOS=""
GITHUB_SCAN_MAX_REPOS_PER_TICK="3"
GITHUB_REPORT_MAX_THREADS_PER_TICK="10"
GITHUB_RECHECK_MAX_THREADS_PER_TICK="10"
GITHUB_SCAN_BATCH_SIZE="3"
GITHUB_REMEDIATION_DSSOC_RECIPIENT="dssoc@example.com"
GITHUB_AGENT_LOG_LEVEL="INFO"
SA_GITHUB_EVIDENCE_DIR=""

# --- 사내 Jenkins ---
JENKINS_BASE_URL="https://jenkins.intra.example.com"
JENKINS_USER=""
JENKINS_API_TOKEN=""

# --- 사내 Confluence ---
CONFLUENCE_BASE_URL="https://confluence.intra.example.com"
CONFLUENCE_USER=""
CONFLUENCE_API_TOKEN=""

# --- SMB 점검 ---
# 3 인증 모드(null=익명, guest, auth=등록 운영 계정). brute force 절대 금지.
# auth 모드 = 등록된 운영 계정. 실제 값은 로컬 .env 또는 secret store 에만 둔다.
SMB_USERNAME=""
SMB_PASSWORD=""
# 한 셰어에서 가져올 최대 파일 수 / 파일 크기 (MB)

# ============================================================
# SMB E2E 파이프라인 (smb_domain_e2e) — 코드 수집기 · 3 에이전트 · 신규 서비스 8767
# ============================================================

# --- 코드 cron 수집기 (service.collector.runner, LLM 0) ---
COLLECTOR_POLL_SECONDS="300"        # poll tick 간격(초)
COLLECTOR_RESCAN_SECONDS="604800"   # subnet 재스윕 쿨다운(기본 7일=주간)
COLLECTOR_LOG_LEVEL="INFO"
# print/spool/driver 폴더 제외 확장 패턴 (CSV, 선택)
SMB_PRINT_SHARE_NAMES=""
SMB_PRINT_DIR_PATTERNS=""

# --- Splunk 담당자 조회 (IP→USER_ID/NAME/DEPT, asset_owner 적재) ---
# MCP-over-SSE 우선(ai-soc/ai-sandbox splunk_search 패턴). 예: http://<host>:<port>/sse
MCP_SPLUNK_URL=""
# REST fallback (services/search/jobs/export, token 인증) — MCP 없을 때만.
SPLUNK_REST_URL=""
SPLUNK_TOKEN=""

# --- 에이전트 LLM (소유: 엔진 .env — 여기에 정의하지 마라) ---
# ⚠️ SA_CHAT_PROFILE / SA_CHAT_PROFILE_CHAIN / SA_TASK_REASONING_EFFORT 는 **코어 소유**다.
#    load_runtime_env 는 skill/.env 를 먼저 읽어 first-wins 하므로, 여기서 핀하면 엔진의
#    단일소스를 이겨 v3.90 split-brain(챗만 바뀌고 워커는 구 모델)이 재발한다.
#    service/tests/test_env_hygiene.py 가 이걸 강제한다. → docs/CONFIG-OWNERSHIP.md
# 엔진 트리 경로(llm_profiles.yaml/.env 로드 기준). 기본 ~/project/secu-agent.
SA_ENGINE_DIR=""
SA_SMB_AGENT_PROFILE=""
SMB_TASK_POLL_SEC="60"              # #1 점검 상주 runner poll 주기
SMB_TASK_MAX_TURNS="40"
SMB_MAIL_MAX_TURNS="15"
SMB_REVERIFY_MAX_TURNS="20"
# 점검 증거/스크린샷 저장 root (path-jail 기준). 비우면 /tmp/smb_e2e_evidence.
SA_SMB_EVIDENCE_DIR=""

# --- 메일 자동 발송 (egress autosend opt-in) ---
# Knox Mail MCP 주소(send) — 미설정 시 fail-closed(발송 불가).
SA_KNOX_MAIL_MCP_URL=""
MAIL_SENDER_EMAIL=""
# autosend opt-in: 이 sink 만 자동 발송(없으면 전부 dry-run).
SA_DELIVERY_AUTOSEND_SINKS="knox_mail"
# 수신 허용 목록(CSV, 빈 값이면 autosend 차단=fail-closed). build phase=담당자 본인만.
#
# ⚠️⚠️ **`@도메인` 항목은 그 도메인 전체를 연다.** 코어 `_recipient_allowed`
# (`agent/delivery.py:140`)가 `lstrip("@")` 후 **도메인 suffix 매칭**을 하기 때문에
# `@samsung.com` 한 줄이면 전사 아무에게나 자동발송이 나간다 — 실측으로 확인했다
# (2026-08-15). 실 담당자 발송이 금지된 단계에서는 **정확한 주소만** 적어라.
#   ✗ "shaneee.baek,shaneee.baek@samsung.com,@samsung.com"   ← 전사 개방
#   ○ "dssoc@samsung.com,shaneee.baek@samsung.com"
#
# ⚠️ 좁힐 때 **SOC 주소를 명시적으로 넣어라.** 이전 값에는 `dssoc@samsung.com` 이
# 없었고 `@samsung.com` 에 얹혀 통과하고 있었다 — 도메인 항목만 지우면 정상 발송까지
# 같이 막힌다.
SA_DELIVERY_RECIPIENT_ALLOW=""
# 개발/리팩토링 중 조치요청/재검증 회신은 DSSOC로만 보낸다.
SMB_REMEDIATION_DSSOC_RECIPIENT="dssoc@example.com"
SMB_REMEDIATION_MAIL_MODE="dssoc_only"
DEFAULT_CHARTER_REF="SECOPS-2026-001"

# --- POP3 수신 (조치요청 답장, service.collector.mail_inbound) ---
POP3_HOST="pop3.samsung.net"
POP3_PORT="995"
POP3_USER=""
POP3_PASSWORD=""
POP3_TIMEOUT="60"
# Optional POP3 smoke test hook: route a unique non-remediation subject into
# an SMB thread without changing production subject matching.
SMB_POP3_TEST_SUBJECT_CONTAINS=""
SMB_POP3_TEST_SUBJECT_TAG=""
# Optional service-domain POP3 smoke hook: route a unique non-remediation
# subject into a GitHub/Confluence report thread by using that domain's normal
# subject tag, e.g. [GitHub 보안취약점 조치요청](org/repo).
SERVICE_POP3_TEST_SUBJECT_CONTAINS=""
SERVICE_POP3_TEST_SUBJECT_TAG=""

# --- 신규 독립 서비스 (webapp, 포트 8767) ---
SA_SMB_WEB_PORT="8767"
SA_SMB_WEB_HOST="127.0.0.1"
# 메일 본문 스크린샷 정적 URL 베이스 (예: http://<host>:8767). 비우면 data-uri 폴백.
SA_SMB_WEB_PUBLIC_URL=""
# 개인 권한 판정 기준 계정(auth-read=부서열람 해석).

# ============================================================
# dev_web E2E 파이프라인 — SMB 8767과 분리된 별도 서버/큐
# ============================================================

DEV_WEB_REPORT_PARALLEL="2"
DEV_WEB_REPLY_VERIFY_PARALLEL="2"
DEV_WEB_TASK_MAX_TURNS="60"
DEV_WEB_REPORT_MAX_TURNS="20"
DEV_WEB_REVERIFY_MAX_TURNS="30"
DEV_WEB_DISCOVERY_SIEM_FILTER="cdep.samsungds.net"
DEV_WEB_DISCOVERY_INCLUDE_REGEX="(?i)(dev|stage|stg|test|qa|sandbox|cdep)"
DEV_WEB_DISCOVERY_EARLIEST="-7d@d"
DEV_WEB_DISCOVERY_LATEST="now"
DEV_WEB_DISCOVERY_MAX_DOMAINS="1000"
DEV_WEB_DISCOVERY_POLL_SECONDS="21600"
# dev_web 증거 저장 root. 비우면 /tmp/dev_web_e2e_evidence.
SA_DEV_WEB_EVIDENCE_DIR=""
# dev_web 독립 서비스 (dev_webapp, 기본 0.0.0.0:8769).
SA_DEV_WEB_PORT="8769"
SA_DEV_WEB_HOST="0.0.0.0"
DEV_WEB_REMEDIATION_DSSOC_RECIPIENT="dssoc@example.com"

# ============================================================
# Confluence E2E 파이프라인 — SMB 8767과 분리된 별도 서버/큐
# ============================================================

# ⚠️ CONFLUENCE_SPACE_PARALLEL / CONFLUENCE_SPACE_BATCH 는 2026-08-28 에 소비자를 잃었다
#    (평면 space/search 레인 은퇴 — 리드가 대상 하나씩 위임한다). 동시성은 이제
#    `lead_agent._DEFAULT_MAX_SESSIONS`(리드당 워커 2) 가 정한다. 지웠으니 설정해도 안 먹는다.
CONFLUENCE_SSO_PARALLEL="1"
CONFLUENCE_REPORT_PARALLEL="2"
CONFLUENCE_RECHECK_PARALLEL="1"
CONFLUENCE_SPACE_DISCOVERY_MAX_SPACES="100000"
CONFLUENCE_SPACE_DISCOVERY_TYPE=""
CONFLUENCE_SSO_DISCOVERY_EARLIEST="-7d"
CONFLUENCE_SSO_DISCOVERY_LATEST="now"
CONFLUENCE_SSO_DISCOVERY_DAY_BUCKET=""
CONFLUENCE_SSO_DISCOVERY_MAX_URLS="2000"
CONFLUENCE_TASK_MAX_TURNS="40"
CONFLUENCE_REMEDIATION_DSSOC_RECIPIENT="dssoc@example.com"
# Confluence 증거 저장 root. 비우면 /tmp/confluence_e2e_evidence.
SA_CONFLUENCE_EVIDENCE_DIR=""
# Confluence 독립 서비스 (기본 0.0.0.0:8773).
SA_CONFLUENCE_WEB_PORT="8773"
SA_CONFLUENCE_WEB_HOST="0.0.0.0"

# --- 웹 점검 (도메인 도구 전용 — scope/UA/timeout 은 엔진 코어 소유) ---
WEB_MAX_PAGES_PER_DOMAIN="50"
# 비파괴 vuln probe만 활성. true면 reflective XSS / .git / .env 노출 등 기본 체크.
WEB_VULN_PROBE_ENABLED="true"

# --- 스케줄러 (도메인 점검 사이클) ---
SA_LOOP_INTERVAL_SEC="21600"
SA_MAX_PARALLEL="2"

# ─── 크리덴셜 로그인 검증 (active — recon→active 경계를 넘는다) ────────────
# 발견한 DB 커넥션스트링/토큰으로 **실제 로그인 1회**를 시도해 크리덴셜이 살아있는지
# 확인한다. finding 을 "평문 노출"에서 "악용 가능(확인됨)"으로 격상시키는 근거.
#
# ⚠️ 기본 OFF 를 유지하라. 필요한 점검 창에서만, 좁은 scope 로 한시적으로 켠다.
# 안전봉투(전부 fail-closed, 실측 확인):
#   · 마스터 OFF        → not_performed (네트워크 접촉 0)
#   · scope 미설정/불일치 → skipped_scope
#   · charter_ref 빈값   → not_performed
#   · 계정당 단발(중앙 영속 원장: engine+IP+port+principal UNIQUE) — 재시도 없음
#   · 로그인 실패/잠금/만료 등 post-LOGIN7 결과는 회로차단기 trip(프로세스 재시작 전까지 중단)
#   · 쿼리/배치 0, 즉시 세션 종료, 평문 무저장, MSSQL 로그인패킷 암호화(enc_login_only)
#
# 마스터 스위치 (미설정=OFF). "1"/"true"/"yes"/"on" 만 활성.
# SA_CRED_PROBE=""
# 대상 allowlist — host 또는 CIDR, 선택적 :port. **빈값 = 전면 거부**(오조작 방지).
# 예: "12.98.64.105:1433"  /  "10.20.0.0/24:5432 10.20.1.5:1433"
# SA_CRED_PROBE_SCOPE=""
# 프로세스 사이클당 최대 시도 수 (기본 5).
# SA_CRED_PROBE_MAX_PER_CYCLE="5"
# MSSQL/PG 서버 인증서 검증용 CA 번들(있으면 verify-full). 없으면 로그인패킷 암호화만.
# SA_DB_LOGIN_CAFILE=""

# ─── exec 도구 우회 억제 가드 (best-effort — 보안 경계 아님) ───────────────
# smb_python / smb_task_python 안에서 DB 드라이버 import·DB 포트 직접 연결·프로세스
# 실행을 차단해, 워커가 승인된 `*_credential_login_probe` 를 우회하지 못하게 한다.
# state DB(SECU_AGENT_PG_DSN 엔드포인트)는 정당한 기능이라 자동 allowlist.
# 추가로 허용할 엔드포인트(공백/콤마 구분 host:port).
# SA_EXEC_GUARD_ALLOW_ENDPOINTS=""
# 추가로 차단할 DB 포트(공백/콤마 구분). 비표준 포트 DB 운영 시 지정.
# SA_EXEC_GUARD_EXTRA_PORTS=""
