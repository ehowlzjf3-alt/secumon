#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)"
NAMESPACE="${SECU_K8S_NAMESPACE:-secu-agent}"
IMAGE="${SECU_K8S_IMAGE:-secu-agent-skill:local}"
POSTGRES_IMAGE="${SECU_K8S_POSTGRES_IMAGE:-postgres:16-bookworm}"
HEADLAMP_IMAGE="${SECU_HEADLAMP_IMAGE:-ghcr.io/headlamp-k8s/headlamp:v0.43.0}"
KUBESHARK_FRONT_IMAGE="${SECU_KUBESHARK_FRONT_IMAGE:-docker.io/kubeshark/front:v53.3}"
KUBESHARK_HUB_IMAGE="${SECU_KUBESHARK_HUB_IMAGE:-docker.io/kubeshark/hub:v53.3}"
KUBESHARK_WORKER_IMAGE="${SECU_KUBESHARK_WORKER_IMAGE:-docker.io/kubeshark/worker:v53.3}"
KIND_CLUSTER_NAME="${SECU_K8S_KIND_CLUSTER:-secu-agent}"
ENGINE_DIR="${SECU_ENGINE_DIR:-$REPO_ROOT/../secu-agent}"
TIMEOUT="${SECU_K8S_ROLLOUT_TIMEOUT:-180s}"

usage() {
  cat <<'USAGE'
Usage:
  deploy/k8s/bin/secu-k8s preflight [local|deploy] [all|kind|base|smb|dev-web|github|confluence|jenkins|headlamp|kubeshark|visualization]
  deploy/k8s/bin/secu-k8s build-image
  deploy/k8s/bin/secu-k8s load-image [kind|docker-desktop|minikube]
  deploy/k8s/bin/secu-k8s render [all|kind|base|smb|dev-web|github|confluence|jenkins|headlamp]
  deploy/k8s/bin/secu-k8s apply [all|kind|base|smb|dev-web|github|confluence|jenkins|headlamp]
  deploy/k8s/bin/secu-k8s wait [all|kind|smb|dev-web|github|confluence]
  deploy/k8s/bin/secu-k8s status
  deploy/k8s/bin/secu-k8s install-headlamp
  deploy/k8s/bin/secu-k8s install-kubeshark
  deploy/k8s/bin/secu-k8s port-forward [smb|dev-web|github|confluence|headlamp|kubeshark]
  deploy/k8s/bin/secu-k8s k9s

Environment:
  SECU_K8S_IMAGE              Image tag. Default: secu-agent-skill:local
  SECU_K8S_POSTGRES_IMAGE     kind overlay Postgres image. Default: postgres:16-bookworm
  SECU_HEADLAMP_IMAGE          Headlamp image to load when present locally.
  SECU_KUBESHARK_FRONT_IMAGE   Kubeshark front image to load when present locally.
  SECU_KUBESHARK_HUB_IMAGE     Kubeshark hub image to load when present locally.
  SECU_KUBESHARK_WORKER_IMAGE  Kubeshark worker image to load when present locally.
  SECU_K8S_KIND_CLUSTER       kind cluster name for load-image kind. Default: secu-agent
  SECU_ENGINE_DIR             Engine repo path. Default: ../secu-agent
  SECU_K8S_NAMESPACE          Namespace. Default: secu-agent
  SECU_K8S_ROLLOUT_TIMEOUT    kubectl rollout timeout. Default: 180s
  SECU_K8S_SKIP_IMAGE_CHECK   Set to 1 to skip local image inspection in preflight deploy.
  SECU_PIP_INDEX_URL          Optional pip index URL for container builds.
  SECU_PIP_TRUSTED_HOST       Optional space-separated pip trusted hosts for container builds.
  SECU_PIP_CERT               Optional in-container pip CA bundle path for container builds.
USAGE
}

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

have() {
  command -v "$1" >/dev/null 2>&1
}

kustomize_path() {
  case "${1:-all}" in
    all) echo "$REPO_ROOT/deploy/k8s/overlays/all" ;;
    kind) echo "$REPO_ROOT/deploy/k8s/overlays/kind" ;;
    base) echo "$REPO_ROOT/deploy/k8s/base" ;;
    smb) echo "$REPO_ROOT/deploy/k8s/domains/smb" ;;
    dev-web) echo "$REPO_ROOT/deploy/k8s/domains/dev-web" ;;
    github) echo "$REPO_ROOT/deploy/k8s/domains/github" ;;
    confluence) echo "$REPO_ROOT/deploy/k8s/domains/confluence" ;;
    jenkins) echo "$REPO_ROOT/deploy/k8s/domains/jenkins" ;;
    headlamp) echo "$REPO_ROOT/deploy/k8s/addons/headlamp" ;;
    *)
      echo "unknown target: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
}

is_render_target() {
  case "${1:-all}" in
    all|kind|base|smb|dev-web|github|confluence|jenkins|headlamp) return 0 ;;
    *) return 1 ;;
  esac
}

target_needs_runtime_secret() {
  case "${1:-all}" in
    all|kind|smb|dev-web|github|confluence) return 0 ;;
    *) return 1 ;;
  esac
}

render_manifest() {
  local target="${1:-all}"
  kubectl kustomize "$(kustomize_path "$target")" \
    | awk -v image="$IMAGE" -v postgres_image="$POSTGRES_IMAGE" '{
        sub(/image: secu-agent-skill:local$/, "image: " image)
        sub(/image: postgres:16-bookworm$/, "image: " postgres_image)
        print
      }'
}

deployments_for() {
  case "${1:-all}" in
    all)
      deployments_for smb
      deployments_for dev-web
      deployments_for github
      deployments_for confluence
      ;;
    kind)
      printf '%s\n' secu-agent-postgres
      deployments_for all
      ;;
    smb)
      printf '%s\n' \
        secu-agent-smb-web \
        secu-agent-smb-collector \
        secu-agent-smb-hunt \
        secu-agent-smb-report-mail \
        secu-agent-smb-reply-verify
      ;;
    dev-web)
      printf '%s\n' \
        secu-agent-dev-web-web \
        secu-agent-dev-web-discovery \
        secu-agent-dev-web-hunt \
        secu-agent-dev-web-report \
        secu-agent-dev-web-reverify
      ;;
    github)
      printf '%s\n' \
        secu-agent-github-web \
        secu-agent-github-runner
      ;;
    confluence)
      printf '%s\n' \
        secu-agent-confluence-web \
        secu-agent-confluence-runner
      ;;
    *)
      echo "no runnable deployments for target: $1" >&2
      exit 2
      ;;
  esac
}

cmd_build_image() {
  need docker
  if [[ ! -d "$ENGINE_DIR" ]]; then
    echo "engine repo not found: $ENGINE_DIR" >&2
    exit 2
  fi

  local build_args=()
  if [[ -n "${SECU_PIP_INDEX_URL:-}" ]]; then
    build_args+=(--build-arg "SECU_PIP_INDEX_URL=$SECU_PIP_INDEX_URL")
  fi
  if [[ -n "${SECU_PIP_TRUSTED_HOST:-}" ]]; then
    build_args+=(--build-arg "SECU_PIP_TRUSTED_HOST=$SECU_PIP_TRUSTED_HOST")
  fi
  if [[ -n "${SECU_PIP_CERT:-}" ]]; then
    build_args+=(--build-arg "SECU_PIP_CERT=$SECU_PIP_CERT")
  fi

  # 사내 CA 를 빌드 컨텍스트로 넘긴다. 프록시가 TLS 를 끊는 환경에서 pip 가
  # CERTIFICATE_VERIFY_FAILED 로 죽는 것을 막는다. 디렉터리가 없으면 빈 디렉터리를
  # 넘겨 사외 빌드에서도 그대로 돈다.
  local ca_dir="${SECU_CA_DIR:-/usr/local/share/ca-certificates}"
  if [[ ! -d "$ca_dir" ]]; then
    ca_dir="$(mktemp -d)"
  fi

  docker buildx build \
    --build-context "skill=$REPO_ROOT" \
    --build-context "engine=$ENGINE_DIR" \
    --build-context "ca=$ca_dir" \
    -f "$REPO_ROOT/deploy/container/Dockerfile" \
    "${build_args[@]}" \
    -t "$IMAGE" \
    "$REPO_ROOT"
}

load_kind_image_if_present() {
  local image="$1"
  if docker image inspect "$image" >/dev/null 2>&1; then
    kind load docker-image "$image" --name "$KIND_CLUSTER_NAME"
  else
    echo "image not present locally; cluster may pull $image"
  fi
}

cmd_load_image() {
  local runtime="${1:-auto}"
  case "$runtime" in
    auto)
      if command -v kind >/dev/null 2>&1; then
        need docker
        kind load docker-image "$IMAGE" --name "$KIND_CLUSTER_NAME"
        load_kind_image_if_present "$POSTGRES_IMAGE"
        load_kind_image_if_present "$HEADLAMP_IMAGE"
        load_kind_image_if_present "$KUBESHARK_FRONT_IMAGE"
        load_kind_image_if_present "$KUBESHARK_HUB_IMAGE"
        load_kind_image_if_present "$KUBESHARK_WORKER_IMAGE"
      elif command -v minikube >/dev/null 2>&1; then
        minikube image load "$IMAGE"
      else
        echo "no local image loader found; install kind or minikube, or push $IMAGE to a registry" >&2
        exit 2
      fi
      ;;
    kind)
      need kind
      need docker
      kind load docker-image "$IMAGE" --name "$KIND_CLUSTER_NAME"
      load_kind_image_if_present "$POSTGRES_IMAGE"
      load_kind_image_if_present "$HEADLAMP_IMAGE"
      load_kind_image_if_present "$KUBESHARK_FRONT_IMAGE"
      load_kind_image_if_present "$KUBESHARK_HUB_IMAGE"
      load_kind_image_if_present "$KUBESHARK_WORKER_IMAGE"
      ;;
    minikube)
      need minikube
      minikube image load "$IMAGE"
      ;;
    docker-desktop)
      echo "docker-desktop uses the local Docker image store; no load step needed for $IMAGE"
      ;;
    *)
      echo "unknown image runtime: $runtime" >&2
      exit 2
      ;;
  esac
}

cmd_render() {
  need kubectl
  render_manifest "${1:-all}"
}

cmd_apply() {
  need kubectl
  render_manifest "${1:-all}" | kubectl apply -f -
}

cmd_wait() {
  need kubectl
  local target="${1:-all}"
  local deployment
  while IFS= read -r deployment; do
    [[ -n "$deployment" ]] || continue
    kubectl -n "$NAMESPACE" rollout status "deployment/$deployment" --timeout="$TIMEOUT"
  done < <(deployments_for "$target")
}

cmd_status() {
  need kubectl
  kubectl -n "$NAMESPACE" get deploy,svc,pods,cm,pvc -o wide
}

cmd_install_headlamp() {
  need helm
  need kubectl
  helm repo add headlamp https://kubernetes-sigs.github.io/headlamp/
  helm upgrade --install headlamp headlamp/headlamp --namespace kube-system
  kubectl apply -k "$REPO_ROOT/deploy/k8s/addons/headlamp"
}

cmd_install_kubeshark() {
  need helm
  helm repo add kubeshark https://helm.kubeshark.com
  helm upgrade --install kubeshark kubeshark/kubeshark \
    --set tap.docker.imagePullPolicy=IfNotPresent \
    --set cloudLicenseEnabled=false \
    --set tap.telemetry.enabled=false \
    --set tap.probes.hub.initialDelaySeconds="${SECU_KUBESHARK_HUB_PROBE_INITIAL_DELAY:-90}" \
    --set tap.probes.hub.failureThreshold="${SECU_KUBESHARK_HUB_PROBE_FAILURE_THRESHOLD:-30}"
}

cmd_port_forward() {
  need kubectl
  case "${1:-}" in
    smb) kubectl -n "$NAMESPACE" port-forward svc/secu-agent-smb-web 8767:8767 ;;
    dev-web) kubectl -n "$NAMESPACE" port-forward svc/secu-agent-dev-web-web 8769:8769 ;;
    github) kubectl -n "$NAMESPACE" port-forward svc/secu-agent-github-web 8770:8770 ;;
    confluence) kubectl -n "$NAMESPACE" port-forward svc/secu-agent-confluence-web 8773:8773 ;;
    headlamp) kubectl -n kube-system port-forward service/headlamp 8080:80 ;;
    kubeshark) kubectl port-forward service/kubeshark-front 8899:80 ;;
    *)
      echo "unknown port-forward target: ${1:-}" >&2
      usage >&2
      exit 2
      ;;
  esac
}

cmd_k9s() {
  need k9s
  K9S_CONFIG_DIR="$REPO_ROOT/deploy/k9s" k9s -n "$NAMESPACE"
}

PREFLIGHT_FAILS=0
PREFLIGHT_WARNS=0

pf_ok() {
  printf 'ok: %s\n' "$*"
}

pf_warn() {
  PREFLIGHT_WARNS=$((PREFLIGHT_WARNS + 1))
  printf 'warn: %s\n' "$*"
}

pf_fail() {
  PREFLIGHT_FAILS=$((PREFLIGHT_FAILS + 1))
  printf 'fail: %s\n' "$*" >&2
}

check_command() {
  local name="$1"
  local severity="${2:-fail}"
  if have "$name"; then
    pf_ok "$name available ($(command -v "$name"))"
  elif [[ "$severity" == "warn" ]]; then
    pf_warn "$name not installed"
  else
    pf_fail "$name not installed"
  fi
}

check_render() {
  local target="$1"
  if ! is_render_target "$target"; then
    pf_warn "no kustomize manifest for $target"
    return 0
  fi
  if render_manifest "$target" >/dev/null; then
    pf_ok "render $target"
  else
    pf_fail "render $target failed"
  fi
}

check_engine_dir() {
  if [[ -d "$ENGINE_DIR" ]]; then
    pf_ok "engine repo found at $ENGINE_DIR"
  else
    pf_fail "engine repo not found: $ENGINE_DIR"
  fi
}

check_image() {
  if [[ "${SECU_K8S_SKIP_IMAGE_CHECK:-}" == "1" ]]; then
    pf_warn "skipping image check for $IMAGE"
    return 0
  fi
  if ! have docker; then
    pf_fail "docker not installed; cannot verify local image $IMAGE"
    return 0
  fi
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    pf_ok "image exists locally: $IMAGE"
  elif [[ "$IMAGE" == */* && "$IMAGE" != *":local" ]]; then
    pf_warn "image is not present locally; assuming the cluster can pull $IMAGE"
  else
    pf_fail "local image not found: $IMAGE; run deploy/k8s/bin/secu-k8s build-image"
  fi
}

check_cluster() {
  if kubectl get namespace "$NAMESPACE" >/dev/null 2>&1; then
    pf_ok "cluster reachable and namespace exists: $NAMESPACE"
  else
    pf_fail "cannot reach namespace $NAMESPACE; check kubeconfig and run apply base"
    return 1
  fi
}

check_runtime_secret() {
  local target="$1"
  if ! target_needs_runtime_secret "$target"; then
    return 0
  fi
  if kubectl -n "$NAMESPACE" get secret secu-agent-runtime >/dev/null 2>&1; then
    pf_ok "runtime secret exists: secu-agent-runtime"
  else
    pf_fail "runtime secret missing in $NAMESPACE: secu-agent-runtime"
  fi
}

check_visualization_tools() {
  local severity="${1:-warn}"
  check_command helm "$severity"
  check_command k9s warn
}

cmd_preflight() {
  local mode="deploy"
  local target="all"

  case "${1:-}" in
    "")
      ;;
    local|deploy)
      mode="$1"
      target="${2:-all}"
      ;;
    *)
      target="$1"
      ;;
  esac

  case "$target" in
    all|kind|base|smb|dev-web|github|confluence|jenkins|headlamp|kubeshark|visualization)
      ;;
    *)
      echo "unknown preflight target: $target" >&2
      usage >&2
      return 2
      ;;
  esac

  PREFLIGHT_FAILS=0
  PREFLIGHT_WARNS=0

  check_command kubectl
  check_command docker warn
  check_engine_dir

  case "$target" in
    visualization)
      check_render headlamp
      check_visualization_tools warn
      ;;
    kubeshark)
      check_visualization_tools warn
      ;;
    *)
      check_render "$target"
      if [[ "$target" == "all" ]]; then
        check_render headlamp
        check_visualization_tools warn
      elif [[ "$target" == "headlamp" ]]; then
        check_visualization_tools warn
      fi
      ;;
  esac

  if [[ "$mode" == "deploy" ]]; then
    check_image
    check_cluster || true
    check_runtime_secret "$target"
    case "$target" in
      headlamp|kubeshark|visualization)
        check_visualization_tools fail
        ;;
    esac
  fi

  if (( PREFLIGHT_FAILS > 0 )); then
    printf 'preflight %s failed: %d failure(s), %d warning(s)\n' "$mode" "$PREFLIGHT_FAILS" "$PREFLIGHT_WARNS" >&2
    return 1
  fi

  printf 'preflight %s passed: %d warning(s)\n' "$mode" "$PREFLIGHT_WARNS"
}

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
    usage
    return 0
  fi
  shift || true
  case "$cmd" in
    preflight) cmd_preflight "$@" ;;
    build-image) cmd_build_image "$@" ;;
    load-image) cmd_load_image "$@" ;;
    render) cmd_render "$@" ;;
    apply) cmd_apply "$@" ;;
    wait) cmd_wait "$@" ;;
    status) cmd_status "$@" ;;
    install-headlamp) cmd_install_headlamp "$@" ;;
    install-kubeshark) cmd_install_kubeshark "$@" ;;
    port-forward) cmd_port_forward "$@" ;;
    k9s) cmd_k9s "$@" ;;
    *)
      echo "unknown command: $cmd" >&2
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
